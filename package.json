{
  "name": "mudanzas-miranda-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "tsx scripts/generate-static-pages.ts && tsx scripts/generate-sitemap.ts",
    "build": "vite build",
    "verify:production": "npm run typecheck && npm run build && npm run audit:static-seo && npm run audit:geo-content && npm run validate:app-composition",
    "audit:static-seo": "tsx scripts/audit-static-seo.ts",
    "validate:app-composition": "tsx scripts/validate-app-composition.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "audit:geo-content": "tsx scripts/audit-geo-content.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}

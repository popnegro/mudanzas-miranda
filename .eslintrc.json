{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "serviceworker": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "Swiper": "readonly"
  },
  "rules": {
    "indent": ["error", 2],
    "no-console": "warn",
    "no-new": "off",
    "no-plusplus": "off",
    "no-param-reassign": [
      "error",
      { "props": false }
    ]
  }
}